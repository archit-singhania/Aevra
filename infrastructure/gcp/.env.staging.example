AEVRA_ENV=staging
AEVRA_SECRET_KEY=replace-with-a-unique-64-character-secret
AEVRA_DATABASE_URL=sqlite:////app/data/aevra.db
AEVRA_SEED_EMAIL=owner@stage.aevra.com
AEVRA_SEED_PASSWORD=replace-with-a-strong-staging-password
AEVRA_MEDIA_ROOT=/app/data/media
AEVRA_STORAGE_BACKEND=local
AEVRA_IMAGE_PROVIDER=deterministic
AEVRA_VIDEO_PROVIDER=mock
AEVRA_ENABLE_CELERY=0
