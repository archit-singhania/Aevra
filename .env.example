AEVRA_ENV=development
AEVRA_SECRET_KEY=replace-with-at-least-32-random-characters
AEVRA_ACCESS_TOKEN_MINUTES=30
AEVRA_SEED_EMAIL=owner@aevra.local
AEVRA_SEED_PASSWORD=AevraLocalOnly!2026
AEVRA_DATABASE_URL=postgresql+psycopg://aevra:aevra@postgres:5432/aevra
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aevra
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=aevra-assets
AEVRA_EMBEDDING_PROVIDER=ollama
AEVRA_EMBEDDING_MODEL=nomic-embed-text
AEVRA_EMBEDDING_DIMENSIONS=384
AEVRA_OLLAMA_BASE_URL=http://host.docker.internal:11434
AEVRA_OLLAMA_MODEL=qwen3:8b
AEVRA_OLLAMA_TIMEOUT_SECONDS=120
AEVRA_KNOWLEDGE_CHUNK_CHARS=900
AEVRA_KNOWLEDGE_CHUNK_OVERLAP=120
AEVRA_MAX_DOCUMENT_BYTES=20971520
NEXT_PUBLIC_API_URL=http://localhost:8000
