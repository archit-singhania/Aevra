{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aevra.local/campaign.schema.json",
  "title": "Campaign intake",
  "type": "object",
  "required": ["name", "goal", "audience", "platforms", "approval_mode"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "audience": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["linkedin", "instagram", "facebook", "threads", "youtube", "x"] } },
    "approval_mode": { "enum": ["MANUAL", "ASSISTED", "AUTONOMOUS"], "default": "MANUAL" }
  },
  "additionalProperties": false
}

