<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. Android 9 (API 28) blocks cleartext HTTP by default, which
  silently kills every call to the local FastAPI workspace: the app builds,
  installs and runs, then every request fails with a connection error that
  reads like the server is down.

  This permits plain HTTP for loopback addresses only — 10.0.2.2 is how the
  Android emulator reaches the host machine; 127.0.0.1 and localhost cover
  `adb reverse` and desktop runs. It lives under src/debug, so release
  builds keep the strict default and still require HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
